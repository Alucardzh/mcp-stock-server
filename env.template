AKPROXY_TOKEN=your-true-token

# 海外行情代理（Yahoo全球个股/离岸汇率/日债fallback；空=禁用Yahoo路径，服务自动降级国内源）
YAHOO_PROXY=http://192.168.3.10:7890

# 竞价分时 CSV 归档根目录（容器内默认 /app/data/auction，本地开发默认 ./data/auction）
AUCTION_ARCHIVE_ROOT=

# 东财 push2 家族上游请求最小间隔（秒），默认 1.5；竞价限流时可调大
EM_PUSH2_MIN_INTERVAL=1.5

# 板块工具入口限流配额（次/60s）与清单缓存 TTL（秒）——v4 §11.1-3：可按调用方负载放宽
EM_RATE_BOARD_QUOTE=40
EM_RATE_BOARDS=40
EM_RATE_BOARD_MEMBERS=20
EM_BOARD_LIST_TTL=300
